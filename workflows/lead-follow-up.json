    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst results = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n\n  // Blank status means New for older records\n  const status = String(lead[\"Status\"] || \"New\")\n    .trim()\n    .toLowerCase();\n\n  const lastFollowUpValue = String(\n    lead[\"Last Follow-Up Sent\"] || \"\"\n  ).trim();\n\n  const rawCount = lead[\"Follow-Up Count\"];\n\n  // Existing leads that already received a reminder count as reminder #1\n  let followUpCount;\n\n  if (\n    rawCount === \"\" ||\n    rawCount === undefined ||\n    rawCount === null\n  ) {\n    followUpCount = lastFollowUpValue ? 1 : 0;\n  } else {\n    followUpCount = Number(rawCount);\n  }\n\n  // Stop after 3 automated reminders\n  if (followUpCount >= 3) {\n    continue;\n  }\n\n  // Ignore completed leads\n  if (status === \"won\" || status === \"lost\") {\n    continue;\n  }\n\n  let needsFollowUp = false;\n  let reason = \"\";\n\n  // NEW leads\n  if (status === \"new\") {\n    const received = new Date(lead[\"Date Received\"]);\n\n    if (!isNaN(received.getTime())) {\n      const hoursSinceReceived =\n        (now - received) / (1000 * 60 * 60);\n\n      // First reminder after 24 hours\n      if (followUpCount === 0 && hoursSinceReceived >= 24) {\n        needsFollowUp = true;\n        reason =\n          \"New lead has not been contacted within 24 hours\";\n      }\n\n      // Reminder #2/#3 every 3 days\n      else if (\n        followUpCount > 0 &&\n        lastFollowUpValue\n      ) {\n        const lastFollowUp =\n          new Date(lastFollowUpValue);\n\n        if (!isNaN(lastFollowUp.getTime())) {\n          const daysSinceFollowUp =\n            (now - lastFollowUp) /\n            (1000 * 60 * 60 * 24);\n\n          if (daysSinceFollowUp >= 3) {\n            needsFollowUp = true;\n            reason =\n              \"New lead still needs follow-up after previous reminder\";\n          }\n        }\n      }\n    }\n  }\n\n  // CONTACTED leads\n  if (status === \"contacted\") {\n    const contacted = new Date(lead[\"Last Contacted\"]);\n\n    if (!isNaN(contacted.getTime())) {\n      const daysSinceContact =\n        (now - contacted) /\n        (1000 * 60 * 60 * 24);\n\n      // First reminder after 3 days\n      if (followUpCount === 0 && daysSinceContact >= 3) {\n        needsFollowUp = true;\n        reason =\n          \"Lead has not been followed up for 3 days\";\n      }\n\n      // Later reminders every 7 days\n      else if (\n        followUpCount > 0 &&\n        lastFollowUpValue\n      ) {\n        const lastFollowUp =\n          new Date(lastFollowUpValue);\n\n        if (!isNaN(lastFollowUp.getTime())) {\n          const daysSinceFollowUp =\n            (now - lastFollowUp) /\n            (1000 * 60 * 60 * 24);\n\n          if (daysSinceFollowUp >= 7) {\n            needsFollowUp = true;\n            reason =\n              \"Contacted lead still needs follow-up after previous reminder\";\n          }\n        }\n      }\n    }\n  }\n\n  if (needsFollowUp) {\n    results.push({\n      json: {\n        ...lead,\n        follow_up_reason: reason,\n        follow_up_count: followUpCount + 1\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
