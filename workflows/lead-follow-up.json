    {
      "parameters": {
        "sendTo": "portfolio@example.com",
        "subject": "=Follow-Up Reminder — {{ $json[\"Customer Name\"] }}",
        "emailType": "text",
        "message": "=FOLLOW-UP REMINDER #{{ $json.follow_up_count }}\n\nThis lead needs attention:  \n\nCustomer: {{ $json[\"Customer Name\"] }} \nEmail: {{ $json.Email }} \nService: {{ $json.Service }} \nProperty Type: {{ $json[\"Property Type\"] }} \nUrgency: {{ $json.Urgency }} \nLead Score: {{ $json[\"Lead Score\"] }} \nLead Temperature: {{ $json[\"Lead Temperature\"] }}\n\nReason: {{ $json.follow_up_reason }}  \n\nSummary: {{ $json.Summary }}  \n\nStatus: {{ $json[\"Status\"] || \"New\" }}\n\nPlease review and follow up with this lead.",
        "options": {}
      },
